rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function employeeDoc() {
      return get(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn() && employeeDoc().data.role == 'admin';
    }

    match /employees/{employeeUid} {
      allow create: if isAdmin() || (signedIn()
        && employeeUid == request.auth.uid
        && request.resource.data.role == 'employee');
      // Employees can only see their own profile; the staff directory belongs
      // to the administrator.
      allow read: if isAdmin() || (signedIn() && employeeUid == request.auth.uid);
      allow update: if isAdmin() || (signedIn()
        && employeeUid == request.auth.uid
        && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /customers/{customerId} {
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /areas/{areaId} {
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /outlets/{outletId} {
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /visits/{visitId} {
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin() || (signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy);
      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
    }

    match /sales/{saleId} {
      allow read: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.saleStatus == 'Pending';
      allow update: if isAdmin() || (signedIn()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && (!('saleStatus' in resource.data) || resource.data.saleStatus != 'Complete'));
      allow delete: if isAdmin() || (
        signedIn()
        && resource.data.createdBy == request.auth.uid
        && (!('saleStatus' in resource.data) || resource.data.saleStatus != 'Complete')
      );
    }

    match /counters/{counterId} {
      allow read, update, create: if signedIn();
    }
  }
}
